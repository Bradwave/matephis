{
  "name": "matephis",
  "version": "1.0.0",
  "private": true,
  "description": "Matephis - Matematica e Fisica con grafici interattivi",
  "scripts": {
    "build": "npm run build:plot && npm run build:physics && npm run build:sets",
    "build:plot": "esbuild assets/js/matephis-plot-src/index.js --bundle --target=es2019 --loader:.svg=text --format=iife --global-name=MatephisPlotBundle --footer:js=\"if(typeof module==='object'&&module.exports){module.exports=MatephisPlotBundle.default;}\" --minify --sourcemap --outfile=assets/js/matephis-plot.js",
    "build:physics": "esbuild assets/js/matephis-physics-src/index.js --bundle --target=es2019 --loader:.svg=text --format=iife --global-name=MatephisPhysicsBundle --footer:js=\"if(typeof module==='object'&&module.exports){module.exports=MatephisPhysicsBundle.default;}\" --minify --sourcemap --outfile=assets/js/matephis-physics.js",
    "build:sets": "esbuild assets/js/matephis-sets-src/index.js --bundle --target=es2019 --loader:.svg=text --format=iife --global-name=MatephisSetsBundle --footer:js=\"if(typeof module==='object'&&module.exports){module.exports=MatephisSetsBundle.default;}\" --minify --sourcemap --outfile=assets/js/matephis-sets.js",
    "dev:js": "esbuild assets/js/matephis-plot-src/index.js --bundle --target=es2019 --loader:.svg=text --format=iife --global-name=MatephisPlotBundle --footer:js=\"if(typeof module==='object'&&module.exports){module.exports=MatephisPlotBundle.default;}\" --minify --sourcemap --outfile=assets/js/matephis-plot.js --watch",
    "dev:physics": "esbuild assets/js/matephis-physics-src/index.js --bundle --target=es2019 --loader:.svg=text --format=iife --global-name=MatephisPhysicsBundle --footer:js=\"if(typeof module==='object'&&module.exports){module.exports=MatephisPhysicsBundle.default;}\" --minify --sourcemap --outfile=assets/js/matephis-physics.js --watch",
    "dev:sets": "esbuild assets/js/matephis-sets-src/index.js --bundle --target=es2019 --loader:.svg=text --format=iife --global-name=MatephisSetsBundle --footer:js=\"if(typeof module==='object'&&module.exports){module.exports=MatephisSetsBundle.default;}\" --minify --sourcemap --outfile=assets/js/matephis-sets.js --watch",
    "dev": "concurrently -k -n \"PLOT,PHYSICS,SETS,JEKYLL\" -c \"cyan,green,yellow,magenta\" \"npm run dev:js\" \"npm run dev:physics\" \"npm run dev:sets\" \"bundle exec jekyll serve\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.5",
    "vitest": "^1.6.0"
  }
}
